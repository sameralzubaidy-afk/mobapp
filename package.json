{
  "scripts": {
    "verify:guides": "node scripts/check-guide-drift.mjs",
    "agent-rules:check": "node scripts/agent-rules/check.mjs",
    "agent-rules:next-id": "node scripts/agent-rules/next-id.mjs",
    "migration-gate": "node scripts/migrations/migration-gate.mjs --static",
    "migration-gate:full": "node scripts/migrations/migration-gate.mjs --full",
    "migration-gate:baseline": "node scripts/migrations/migration-gate.mjs --update-baseline",
    "migration-gate:status": "node scripts/migrations/migration-gate.mjs --lock-status",
    "migration:next-number": "node scripts/migrations/reserve-number.mjs --next",
    "migration:ledger-audit": "node scripts/migrations/ledger-audit.mjs",
    "hooks:install": "git config core.hooksPath .githooks && echo 'core.hooksPath -> .githooks (migration gate pre-commit preview installed)'",
    "test:e2e": "bash test-automation/trade-flow-v2/scripts/run-suite.sh",
    "test:e2e:ios": "bash test-automation/trade-flow-v2/scripts/run-suite.sh --runner maestro --platform ios",
    "test:e2e:android": "bash test-automation/trade-flow-v2/scripts/run-suite.sh --runner maestro --platform android",
    "test:e2e:admin": "bash test-automation/trade-flow-v2/scripts/run-suite.sh --runner playwright",
    "test:e2e:dry": "bash test-automation/trade-flow-v2/scripts/run-suite.sh --dry-run",
    "tfv2": "bash test-automation/trade-flow-v2/scripts/run-suite.sh",
    "tfv2:list": "node test-automation/trade-flow-v2/run-tradeflow-suite.mjs --list",
    "tfv2:dry": "bash test-automation/trade-flow-v2/scripts/run-suite.sh --dry-run",
    "tfv2:ios": "bash test-automation/trade-flow-v2/scripts/run-suite.sh --runner maestro --platform ios",
    "tfv2:android": "bash test-automation/trade-flow-v2/scripts/run-suite.sh --runner maestro --platform android",
    "tfv2:admin": "bash test-automation/trade-flow-v2/scripts/run-suite.sh --runner playwright"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "dotenv": "^17.2.3",
    "expo-notifications": "^0.32.16"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
