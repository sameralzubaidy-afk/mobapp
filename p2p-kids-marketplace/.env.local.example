# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# QA Stripe READ-ONLY key (FIX-Task-33) — QA node scripts only, NOT the app.
#
# SERVER-ONLY and deliberately NOT prefixed with EXPO_PUBLIC_ — it must never be
# bundled into the mobile app. Only scripts/qa/stripe-inspect.mjs reads it, to
# read the REAL Stripe object state for money test cases (the playbook's R100
# "not DB-checkable - needs the provider" gap).
#
# Create a RESTRICTED, read-only, TEST-mode key in the Stripe Dashboard
# (Developers -> API keys -> Create restricted key). Permissions: READ-ONLY on
# PaymentIntents, Charges, Refunds, SetupIntents, PaymentMethods, Customers,
# Subscriptions, Invoices, Payouts, Transfers, Events, Disputes — plus
# connected-account read scope on the platform account (for seller payouts /
# transfers on Connect accounts).
#
# This key is intentionally SEPARATE from the fixture scripts' full test-mode
# secret key (~/.dt11-stripe-key, which needs write access). Do NOT put that
# secret key here: stripe-inspect rejects it unless the caller explicitly opts
# into a labelled break-glass run.
STRIPE_QA_READONLY_KEY=rk_test_your-restricted-read-only-key-here

# Public Stripe onboarding redirect landing page (MUST be an https:// URL).
# Use a host that serves real HTML (Cloudflare Worker recommended).
# Example (dev): https://p2p-kids-cf-worker-dev.<your-account>.workers.dev
EXPO_PUBLIC_STRIPE_REDIRECT_BASE_URL=

# Analytics Configuration
EXPO_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-key-here

# Sentry Configuration
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-here

# SendGrid Configuration (Email)
#
# PROD-012: SENDGRID_API_KEY is SERVER-ONLY. Do NOT prefix it with
# EXPO_PUBLIC_ — that would bundle the secret into the mobile app and leak it
# to every device. Mobile email sends are routed through the
# supabase/functions/send-email/ Edge Function which reads SENDGRID_API_KEY
# from its Edge Function secrets.
SENDGRID_API_KEY=your-sendgrid-api-key-here  # SERVER-ONLY
SENDGRID_TEMPLATE_WELCOME=d-03b02b1c7a7e4579b6371aafda4fe10a
SENDGRID_TEMPLATE_PASSWORD_RESET=d-b8d56d23c0194c8caab4991a29fe6559
SENDGRID_TEMPLATE_TRADE_NOTIFICATION=d-dcc9711774484e4aa8ff2fb55bd9ccea
SENDGRID_TEMPLATE_TRANSACTION_CONFIRMATION=d-wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww
SENDGRID_TEMPLATE_SUBSCRIPTION_STATUS=d-vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv

# CI / Server tokens (DO NOT commit real values; keep these in local .env.local or in GitHub Actions / EAS secrets)
# EXPO_TOKEN is used by EAS/EAS builds and should be stored as an Actions secret or in your local .env.local only.
EXPO_TOKEN=your-expo-ci-token-here

# SUPABASE_SERVICE_ROLE_KEY must NEVER be included in client/mobile bundles.
# Store the service role key only in server-side environments or CI (e.g. GitHub Actions secrets).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Sentry auth token used by CI/CD for release uploads. Keep as a CI secret, not in client bundles.
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# Environment
EXPO_PUBLIC_ENVIRONMENT=development

# Dev/QA only (FIX-Task-24 item 6): hide the RN LogBox notification overlay.
# The overlay does not pass taps through and sits over bottom-anchored CTAs, which
# silently ate "Submit for Review" / "AI auto-fill" during QA. Set to true for a QA
# run that needs unobstructed taps; read console output from Metro (:8081) or
# `adb logcat` instead. Only honored in a dev build (__DEV__). Leave unset normally.
EXPO_PUBLIC_QA_QUIET_LOGBOX=false

# R7 — Web-First Subscription: consumer web app base URL (membership + checkout on the web)
EXPO_PUBLIC_SUBSCRIPTION_WEB_URL=https://passitup.com
