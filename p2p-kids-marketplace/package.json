{
  "name": "p2p-kids-marketplace",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "tfv2": "node ../test-automation/trade-flow-v2/run-tradeflow-suite.mjs",
    "qa:ocr": "node scripts/qa/ocr.mjs",
    "qa:badge-scan": "node scripts/qa/badge-scan.mjs",
    "qa:image-diff": "node scripts/qa/image-diff.mjs",
    "qa:inspect-screen": "node scripts/qa/inspect-screen.mjs",
    "qa:ax-tree": "node scripts/qa/ax-tree.mjs",
    "testid-drift-check": "node scripts/testid-drift-check.mjs",
    "test:ci": "jest --runInBand --reporters=default",
    "start": "expo start --clear",
    "start:fresh": "npx kill-port 8081 2>/dev/null; expo start --clear",
    "start:android": "expo start --clear --localhost --android",
    "start:android:dev": "expo start --dev-client --clear --localhost --android",
    "logs:android": "bash ./scripts/android-logs.sh",
    "start:android:logs": "bash ./scripts/start-android-with-logs.sh",
    "android": "expo run:android",
    "ios": "bash scripts/build-ios-simulator.sh --fast",
    "ios:fresh": "npx kill-port 8081 2>/dev/null; bash scripts/build-ios-simulator.sh --fast",
    "android:fresh": "npx kill-port 8081 2>/dev/null; expo run:android --clear",
    "ios:nuclear": "bash scripts/build-ios-simulator.sh",
    "android:nuclear": "rm -rf android/build android/app/build node_modules/.cache 2>/dev/null; expo prebuild --clean --platform android && expo run:android",
    "reinstall:ios": "bash scripts/reinstall-ios.sh",
    "reinstall:ios:build": "bash scripts/reinstall-ios.sh --build",
    "dev:ios": "bash scripts/dev-ios.sh",
    "dev:ios:build": "bash scripts/dev-ios.sh --build",
    "dev:android": "bash scripts/dev-android.sh",
    "dev:android:build": "bash scripts/dev-android.sh --build",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "postinstall": "patch-package",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='integration|e2e'",
    "test:integration": "RUN_SUPABASE_E2E=true jest --testPathPattern='integration' --runInBand",
    "test:e2e": "RUN_SUPABASE_E2E=true jest --testPathPattern='e2e' --runInBand",
    "test:all": "RUN_SUPABASE_E2E=true jest --runInBand",
    "test:auth": "RUN_SUPABASE_E2E=true jest --testPathPattern='auth' --runInBand",
    "test:trades": "RUN_SUPABASE_E2E=true jest --testPathPattern='trade' --runInBand",
    "test:unit:trade": "jest src/services/__tests__/trade.test.ts",
    "test:e2e:cloudflare": "jest e2e/cloudflare-cache.integration.test.ts e2e/delete-purge.integration.test.ts --runInBand",
    "test:maestro": "maestro test .maestro/",
    "test:maestro:ios": "node scripts/run-maestro-ios.mjs",
    "test:maestro:android": "node scripts/run-maestro-android.mjs",
    "t:maestro:android": "node scripts/run-maestro-android.mjs",
    "t:maestro:ios": "node scripts/run-maestro-ios.mjs",
    "test:maestro:ios:all": "maestro test --platform ios .maestro/",
    "test:maestro:android:all": "maestro test --platform android .maestro/",
    "seed:staging": "npx ts-node scripts/seed-staging-data.ts",
    "seed:staging:extended": "npx ts-node scripts/seed-staging-data.ts --extended",
    "seed:c04-fixture": "npx ts-node scripts/provision-c04-collision-fixture.ts",
    "seed:linked-provider-fixture": "npx ts-node scripts/provision-linked-provider-fixture.ts",
    "clean:staging": "npx ts-node scripts/clean-staging-data.ts",
    "reset:staging": "npm run clean:staging && npm run seed:staging",
    "reset:staging:extended": "npm run clean:staging && npm run seed:staging:extended",
    "cleanup:trades": "npx ts-node scripts/cleanup-test-trades.ts",
    "reset:pending-trades": "npm run cleanup:trades",
    "clean": "rm -rf node_modules && npm install",
    "check:supabase": "node ./scripts/check-supabase.js",
    "e2e:build:ios": "SENTRY_DISABLE_AUTO_UPLOAD=true SENTRY_ALLOW_FAILURE=true npx expo prebuild --platform ios --no-install && SENTRY_DISABLE_AUTO_UPLOAD=true SENTRY_ALLOW_FAILURE=true xcodebuild -workspace ios/PassItUp.xcworkspace -scheme PassItUp -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build CODE_SIGN_IDENTITY=\"\" CODE_SIGNING_REQUIRED=NO",
    "e2e:run:ios": "detox test --configuration ios.sim.debug detox/tests/_run-all.e2e.ts -- --runInBand",
    "e2e:build:android": "npx expo prebuild --platform android --no-install && cd android && ./gradlew assembleDebug",
    "e2e:run:android": "detox test --configuration android.emu.debug",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:android": "detox test --configuration android.emu.debug",
    "e2e:ios:smoke": "detox test --configuration ios.sim.debug detox/tests/01-auth-login.e2e.ts detox/tests/04a-trade-initiate.e2e.ts detox/tests/09-profile.e2e.ts detox/tests/10-discovery-browse.e2e.ts",
    "e2e:android:smoke": "detox test --configuration android.emu.debug detox/tests/01-auth-login.e2e.ts detox/tests/04a-trade-initiate.e2e.ts detox/tests/09-profile.e2e.ts detox/tests/10-discovery-browse.e2e.ts"
  },
