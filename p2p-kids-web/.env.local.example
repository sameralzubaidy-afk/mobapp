# p2p-kids-web environment template
# Copy to .env.local and fill real values. Never commit .env.local.

# Supabase (shared backend)
SUPABASE_URL=https://your-project.supabase.co

# Supabase ANON / publishable key — used server-side ONLY for reading public
# admin_config marketing values (price/fee/trial) rendered on /join, the success
# page, and home. It is NOT a secret, but keep it consistent with the project the
# checkout Edge Function targets.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shared secret between this web app and the create-checkout-session Edge Function
# (MUST equal the SUBSCRIPTION_WEB_SECRET secret set on the Supabase Edge Function:
#   supabase secrets set SUBSCRIPTION_WEB_SECRET=<same value> --project-ref <ref>
# Note: the checkout Edge Function reads its own STRIPE_SECRET_KEY Edge Function
# secret — this app never stores a Stripe key and never touches raw card data
# (hosted Stripe Checkout keeps card data on Stripe).
SUBSCRIPTION_WEB_SECRET=your-web-secret-here

# DEV ONLY — when true, /api/checkout returns a local mock success page and never
# calls the Edge Function / Stripe. NEVER set SUBSCRIPTION_DEV_MODE=true in a
# staging/production deployment. To test the REAL flow locally, set this to
# false (or remove) and make SUBSCRIPTION_WEB_SECRET match the EF secret.
SUBSCRIPTION_DEV_MODE=true
