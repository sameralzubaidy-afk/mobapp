# Supabase (shared backend)
SUPABASE_URL=https://your-project.supabase.co

# Shared secret between this web app and the create-checkout-session Edge Function
# (MUST equal the SUBSCRIPTION_WEB_SECRET secret set on the Supabase Edge Function).
SUBSCRIPTION_WEB_SECRET=your-web-secret-here

# Stripe keys are used SERVER-SIDE only (hosted Checkout keeps card data on Stripe)
STRIPE_SECRET_KEY=sk_test_your-key-here
