# TradeFlowV2 orchestrator environment (copy to .env and fill in).
# All values are OPTIONAL — the runner has sensible defaults and self-skips
# anything that is not configured.

# ── Mobile (Maestro) ────────────────────────────────────────────────────────
# App bundle id installed on the simulators/emulators. Defaults to the value in
# manifest.json (com.sameralzubaidi.p2pmarketplace). Set to host.exp.Exponent for Expo Go.
APP_ID=com.sameralzubaidi.p2pmarketplace

# Pin a specific device by UDID/serial (overrides name-based lookup below).
# IOS_SIMULATOR_UDID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
# ANDROID_EMULATOR_SERIAL=emulator-5554

# Dedicated test device name — prevents conflicts with your manual-testing simulator.
# Set this to a model name you DON'T use for manual testing so the test suite
# boots its own simulator and leaves yours alone.
# Create it in Xcode: Window → Devices and Simulators → "+" → pick model + name.
# Default: "iPhone 16 Pro"
# TFV2_IOS_DEVICE_NAME=iPhone 16 Pro

# Same for Android (AVD name created in Android Studio AVD Manager).
# Default: "pixel_7_e2e"
# TFV2_ANDROID_AVD_NAME=pixel_7_e2e

# ── Admin web (Playwright) ──────────────────────────────────────────────────
ADMIN_BASE_URL=http://localhost:3001
PLAYWRIGHT_ADMIN_E2E=true
# Admin login used by authenticated admin specs. If unset, those specs self-skip.
PLAYWRIGHT_ADMIN_EMAIL=test-admin@kidsmarketplace.test
# Type the password directly into your shell/CI secret store — do NOT commit it.
PLAYWRIGHT_ADMIN_PASSWORD=

# ── Runner tuning ───────────────────────────────────────────────────────────
TFV2_RETRIES=1
TFV2_TIMEOUT_MS=600000

# ── Screenshots ──────────────────────────────────────────────────────────────
# Set to "true" to capture screenshots at every key verification step in the
# Maestro flows. Screenshots are saved to:
#   e2e-test-results/<timestamp>/screenshots/<flow-name>/
# Can be toggled at runtime via env var without modifying YAML files.
# Screenshots are always captured on failure regardless of this setting.
TFV2_SCREENSHOTS_ENABLED=true
